# Redpanda / Kafka-API-compatible broker configuration
REDPANDA_BROKERS=localhost:9092
REDPANDA_CONSUMER_GROUP_ID=analytics-telemetry-platform
REDPANDA_BEACON_TOPIC=qoe-playback-beacons

# ClickHouse configuration
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=telemetry_lake
CLICKHOUSE_MAX_OPEN_CONNECTIONS=32
CLICKHOUSE_REQUEST_TIMEOUT_MILLIS=30000

# Micro-batch ingestion tuning (see README "Ingestion Throughput Targets")
BEACON_MICROBATCH_MAX_ROWS=50000
BEACON_MICROBATCH_MAX_LINGER_MILLIS=500

# Redis (optional) - when set, chunk-provenance lookups use
# RedisBackedChunkProvenanceLookup (multi-replica-safe); when unset, falls
# back to InMemoryChunkProvenanceLookup (single-instance/local dev only).
REDIS_URL=redis://localhost:6379

# Outbound webhook targets for live A/B rollback automation and anomaly
# auto-remediation (see README "Outbound Webhook Contracts").
CONTROL_PLANE_BASE_URL=http://localhost:4000
EDGE_PACKAGING_BASE_URL=http://localhost:4100
